# Copy to .env and fill in. Never commit .env.
# Settings read exported variables; .env is not loaded automatically.

# API bind address (export these variables; use 0.0.0.0 in containers)
CLOUDSCOPE_API_HOST=127.0.0.1
CLOUDSCOPE_API_PORT=8000
# Trusted proxy IPs/CIDRs (comma-separated). T-041 Helm sets the web/ingress pod CIDR.
# Never use *; clients must not be able to spoof forwarded headers.
CLOUDSCOPE_FORWARDED_ALLOW_IPS=127.0.0.1

# Local development database (matches docker-compose.yml)
# If changing POSTGRES_PORT, update the URLs below too.
POSTGRES_PORT=5432
CLOUDSCOPE_DATABASE_URL=postgresql+psycopg://cloudscope:cloudscope@localhost:5432/cloudscope

# Optional test service connection; tests create/drop a separate database.
# Export to override the default; pytest does not load .env.
# CLOUDSCOPE_TEST_DATABASE_URL=postgresql+psycopg://cloudscope:cloudscope@localhost:5432/postgres

# Fernet key for encrypting TOTP secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUDSCOPE_SECRET_KEY=

# Relative to the process working directory; use ../config/accounts.yaml from backend/.
# Missing file means no file accounts; enabled UI-managed database accounts still scan.
CLOUDSCOPE_ACCOUNTS_FILE=config/accounts.yaml
CLOUDSCOPE_SESSION_TTL_HOURS=12
CLOUDSCOPE_SESSION_MAX_AGE_DAYS=7
CLOUDSCOPE_COOKIE_SECURE=false
CLOUDSCOPE_COLLECT_CONCURRENCY=8

# AWS base credentials (local only; use AWS_PROFILE or keys, read-only)
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Alibaba Cloud base credentials (read-only)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Opt in after granting the documented read-only LB permissions.
CLOUDSCOPE_LOAD_BALANCERS_ENABLED=false
# Enable only after granting read-only network inventory permissions.
CLOUDSCOPE_NETWORK_ENABLED=false
CLOUDSCOPE_DEDICATED_CREDENTIALS_ENABLED=false
CLOUDSCOPE_CREDENTIALS_NAMESPACE=cloudscope-credentials
CLOUDSCOPE_CREDENTIALS_OWNER=cloudscope
# Optional local development adapter: absolute, private directory outside source.
CLOUDSCOPE_LOCAL_CREDENTIALS_DIRECTORY=

# Keycloak SSO: empty issuer disables SSO. With SSO on, local login is admin-only.
# Use the public realm URL (issuer must match the ID token iss), not a cluster URL.
CLOUDSCOPE_OIDC_ISSUER=
CLOUDSCOPE_OIDC_CLIENT_ID=cloudscope
# Store in the application Secret in production.
CLOUDSCOPE_OIDC_CLIENT_SECRET=
# Public app origin, e.g. https://cloudscope.example.com (never inferred from headers).
CLOUDSCOPE_PUBLIC_URL=
